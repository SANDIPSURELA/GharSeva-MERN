# Copy this file to server/.env. Never put this connection string in React.
MONGODB_URI=mongodb+srv://DB_USERNAME:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/gharseva?retryWrites=true&w=majority
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# 0 for direct local connections; 1 for the documented single Render proxy.
# Recheck your proxy topology before changing this. Never use true.
TRUST_PROXY_HOPS=0
# Set before npm run seed. These passwords create fictional demo accounts.
SEED_CUSTOMER_PASSWORD=Customer123
SEED_PROVIDER_PASSWORD=Provider123
SEED_ADMIN_PASSWORD=Admin12345

# Verified registration / delivery. Never use test mode on a public server.
# npm run demo enables test mode in its temporary process; no real messages are sent.
AUTH_DELIVERY_MODE=live
GHARSEVA_DEMO=false
# Production enforces verification regardless; true also enforces it in development.
REQUIRE_VERIFIED_REGISTRATION=true

# Email numeric OTP through an SMTP provider; credentials stay on the server.
# npm.cmd run integrations:check -- --smtp-connect checks connection only; sends no message.
# Inbox receipt must be confirmed separately using an explicitly authorised test account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS OTP through Twilio Verify. Follow the provider's destination requirements.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Google and Apple through Firebase Authentication.
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
# Option A: full private path to a service-account JSON outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: hosting secret environment variables (not a client .env file).
FIREBASE_CLIENT_EMAIL=
# Newlines may be literal or represented by \n.
FIREBASE_PRIVATE_KEY=

# Optional customer service assistant. Guided matching works without an AI account.
# Keep the API key on the server; never use a VITE_ variable for it.
ASSISTANT_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Private provider identity-review images (local OCR; no external AI service).
# Generate 32 random bytes in hex. Required for production; keep this stable and private.
IDENTITY_STORAGE_KEY=
# Production always requires the identity step for NEW provider accounts.
# Existing providers are preserved. true also enforces it for new local registrations.
REQUIRE_PROVIDER_IDENTITY=true

# New-booking deposit + approved final-balance payments; TEST/simulation only.
# npm.cmd run demo forces simulation regardless of .env. Live keys are refused.
# Persistent MongoDB + server test keys: npm.cmd run dev.
# Existing index upgrade: node scripts/migrate-payment-stages.js --dry-run, then --apply.
# Setup: docs/PAYMENTS-TWO-STAGE-UPDATE.md
PAYMENTS_MODE=disabled
PAYMENT_DEPOSIT_RUPEES=99
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Password login always requires registered-email OTP, including admin/mobile identifiers.
# Real LOCAL email: AUTH_DELIVERY_MODE=live, GHARSEVA_DEMO=false, persistent MongoDB + SMTP, then npm run dev from the root.
# npm run demo overrides these flags and never sends real email.
# Render Free blocks SMTP ports 25/465/587. Use an SMTP-capable host/instance.
# Setup: docs/LOGIN-TWO-STEP-SETUP.md

# Revocable browser sessions and administrator protection (server only).
# Existing JWT-only sessions require one login again after this update.
# No database reset/seed or secret rotation is required.
SESSION_ABSOLUTE_HOURS=8
ADMIN_IDLE_MINUTES=15
ADMIN_REAUTH_MINUTES=5
# Details and review: docs/SESSION-SECURITY-UPDATE.md
