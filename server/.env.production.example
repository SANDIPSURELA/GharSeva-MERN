# Reference only: provide actual values through the host's private settings.
# The application loads server/.env locally, not this template automatically.
NODE_ENV=production
MONGODB_URI=mongodb+srv://DB_USERNAME:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/gharseva?retryWrites=true&w=majority
JWT_SECRET=replace_this_with_your_stable_random_secret
IDENTITY_STORAGE_KEY=replace_with_existing_64_hex_key_or_generate_for_a_new_database
CLIENT_ORIGIN=https://YOUR-ACTUAL-SERVICE.onrender.com
TRUST_PROXY_HOPS=1
GHARSEVA_DEMO=false
AUTH_DELIVERY_MODE=live
# Render Free email: verify sender/domain, then set the private API key.
EMAIL_TRANSPORT=brevo
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=GharSeva
REQUIRE_VERIFIED_REGISTRATION=true
REQUIRE_PROVIDER_IDENTITY=true
PAYMENTS_MODE=disabled
# Select razorpay_test only after private TEST setup. Required payments stay blocked while disabled.
# Preserve the existing configured deposit amount; this default is for a new installation only.
PAYMENT_DEPOSIT_RUPEES=99
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# No private payment keys in VITE_* settings. See RAZORPAY-TWO-STAGE-VERIFICATION.md.
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false
# Optional social sign-in: enable providers independently only after owner setup.
# Public web values for the SAME Firebase project as the private Admin credential:
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
# Choose ONE Admin credential source; prefer a Render secret JSON file:
GOOGLE_APPLICATION_CREDENTIALS=
# Or the matching inline pair; private key supports literal newlines or backslash-n:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Apple Team ID/Services ID/Key ID/.p8 go in Firebase's Apple provider settings, never React.
# See SOCIAL-SIGNIN-SETUP-AND-VERIFICATION.md. Leave FIREBASE_AUTH_EMULATOR_HOST unset.
ASSISTANT_AI_ENABLED=false
# SMTP remains optional on hosts supporting it (EMAIL_TRANSPORT=smtp).
# SMS/Firebase/AI and Razorpay TEST remain separate, optional configurations.
# See docs/HOSTING-DEPLOYMENT.md and server/.env.example.

# Password login always requires registered-email OTP, including admin/mobile identifiers.
# Real LOCAL email: AUTH_DELIVERY_MODE=live, GHARSEVA_DEMO=false, persistent MongoDB + selected email transport, then npm run dev from the root.
# npm run demo overrides these flags and never sends real email.
# Render Free blocks SMTP ports 25/465/587. Use the selected Brevo HTTPS adapter.
# Setup and inbox-test procedure: docs/EMAIL-OTP-RENDER.md
# Setup: docs/LOGIN-TWO-STEP-SETUP.md
