      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const c = pm.response.headers.get(\"Set-Cookie\"); if(c) pm.collectionVariables.set(\"admin_cookie\", c.split(\";\")[0]);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Find tomorrow slots",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-GharSeva",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/providers/{{provider_id}}/slots?date={{appointment_date}}"
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = new Date(Date.now() + 86400000 + 19800000);",
              "pm.collectionVariables.set(\"appointment_date\", d.toISOString().slice(0, 10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const slots=pm.response.json().slots; if(slots.length) pm.collectionVariables.set(\"appointment_time\", slots[0]);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Create customer booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-GharSeva",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{customer_cookie}}"
          }
        ],
        "url": "{{base_url}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"providerId\": \"{{provider_id}}\",\n  \"date\": \"{{appointment_date}}\",\n  \"time\": \"{{appointment_time}}\",\n  \"address\": \"10 Sample Street, Bengaluru\",\n  \"notes\": \"Postman demonstration: kitchen tap repair\",\n  \"urgency\": \"PRIORITY\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const b=pm.response.json(); pm.collectionVariables.set(\"booking_id\",b._id); pm.collectionVariables.set(\"visit_code\",b.visitCode); pm.test(\"Starts pending\",()=>pm.expect(b.status).to.eql(\"PENDING\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Provider sees same booking",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-GharSeva",
            "value": "1"
          },
          {
            "key": "Cookie",
            "value": "{{provider_cookie}}"
          }
        ],
        "url": "{{base_url}}/bookings"
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const b=pm.response.json().find(b=>b._id===pm.collectionVariables.get(\"booking_id\")); pm.test(\"Provider gets booking without OTP\",()=>{pm.expect(b).to.exist;pm.expect(b.visitCode).to.eql(undefined);});"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Provider accepts",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "X-GharSeva",
            "value": "1"
