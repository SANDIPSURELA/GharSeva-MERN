{
  "info": {
    "name": "GharSeva MERN \u2014 Booking Journey",
    "description": "Run in order with the API at port 5000. Demo data requires npm run demo or npm run seed. Role cookies are stored separately. Writes use X-GharSeva: 1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "customer_password",
      "value": "Customer123",
      "type": "string"
    },
    {
      "key": "provider_password",
      "value": "Provider123",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "Admin12345",
      "type": "string"
    },
    {
      "key": "provider_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "booking_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "visit_code",
      "value": "",
      "type": "string"
    },
    {
      "key": "appointment_date",
      "value": "",
      "type": "string"
    },
    {
      "key": "appointment_time",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer_cookie",
      "value": "",
      "type": "string"
    },
    {
      "key": "provider_cookie",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_cookie",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-GharSeva",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/health"
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"MongoDB connected\", () => pm.expect(pm.response.json().database).to.eql(\"connected\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Discover providers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-GharSeva",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/providers"
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const p = pm.response.json().find(p => p.name === \"Rajesh Kumar\") || pm.response.json()[0];",
              "if (p) pm.collectionVariables.set(\"provider_id\", p._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Log in as customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-GharSeva",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"customer@gharseva.com\",\n  \"password\": \"{{customer_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const c = pm.response.headers.get(\"Set-Cookie\"); if(c) pm.collectionVariables.set(\"customer_cookie\", c.split(\";\")[0]);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Log in as provider",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-GharSeva",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"provider@gharseva.com\",\n  \"password\": \"{{provider_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const c = pm.response.headers.get(\"Set-Cookie\"); if(c) pm.collectionVariables.set(\"provider_cookie\", c.split(\";\")[0]);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Log in as admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-GharSeva",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"admin@gharseva.com\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "protocolProfileBehavior": {
        "disableCookies": true
